# ==========================================
# Techvunex AI Assistant - Environment Config
# ==========================================

# Application
APP_NAME=Techvunex AI Assistant
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Base Target Website
TECHVUNEX_BASE_URL=https://techvunex.in/

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./techvunex.db
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techvunex
USE_POSTGRES=false

# Redis Caching
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# LLM Provider Configuration: gemini, openai, groq, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings & RAG Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
RRF_K=60

# Security & Authentication
JWT_SECRET=production-secret-key-change-me-techvunex-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin@techvunex.in
ADMIN_PASSWORD=Techvunex@Admin2026
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*

# ==========================================
# 100% Free Lead Notifications
# ==========================================
# 1. Email Notifications (Standard Python SMTP - ₹0 / Free)
# For Gmail: Use smtp.gmail.com, Port 587, your email, and a 16-character Google App Password
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
NOTIFICATION_EMAIL_TO=sales@techvunex.in,owner@gmail.com

# 2. Telegram Bot Instant Mobile Alerts (100% Free, Unlimited, 0 Setup cost)
# Create a free bot via @BotFather on Telegram in 2 minutes
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. WhatsApp Cloud API (Meta Official Free Tier: 1,000 conversations/month)
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=917834979979
